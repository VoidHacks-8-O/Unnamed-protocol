<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TrustNet // Cyber-Financial Intelligence & Multi-Hop Mule Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    :root {
      --bg-dark: #070B14;
      --card-bg: #0D1424;
      --card-border: #1E293B;
      --accent-cyan: #00E5FF;
      --accent-green: #00E676;
      --accent-red: #FF1744;
      --accent-orange: #FF9100;
      --accent-pink: #F50057;
      --accent-blue: #3B82F6;
      --text-main: #F8FAFC;
      --text-muted: #94A3B8;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Top Navigation */
    header {
      background: rgba(13, 20, 36, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #00E5FF, #2563EB);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #070B14;
      font-weight: 800;
      font-size: 20px;
      box-shadow: 0 0 16px rgba(0, 229, 255, 0.4);
    }

    .brand-title {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-title span {
      color: var(--accent-cyan);
    }

    .brand-subtitle {
      font-size: 11px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-soc {
      background: rgba(0, 230, 118, 0.12);
      border: 1px solid rgba(0, 230, 118, 0.4);
      color: var(--accent-green);
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 4px 8px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .badge-soc::before {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--accent-green);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent-green);
      animation: pulse 1.8s infinite;
    }

    .public-link-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid rgba(0, 229, 255, 0.35);
      padding: 5px 12px;
      border-radius: 8px;
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.2); }
      100% { opacity: 1; transform: scale(1); }
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.2s ease;
      border: none;
      text-decoration: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, #00E5FF, #0284C7);
      color: #070B14;
      font-weight: 700;
    }

    .btn-primary:hover {
      box-shadow: 0 0 15px rgba(0, 229, 255, 0.5);
      transform: translateY(-1px);
    }

    .btn-freeze {
      background: linear-gradient(135deg, #FF1744, #B91C1C);
      color: #FFFFFF;
      box-shadow: 0 0 12px rgba(255, 23, 68, 0.35);
      animation: alertPulse 2.5s infinite;
    }

    @keyframes alertPulse {
      0% { box-shadow: 0 0 10px rgba(255, 23, 68, 0.3); }
      50% { box-shadow: 0 0 20px rgba(255, 23, 68, 0.7); }
      100% { box-shadow: 0 0 10px rgba(255, 23, 68, 0.3); }
    }

    .btn-freeze:hover {
      background: #FF1744;
      box-shadow: 0 0 22px rgba(255, 23, 68, 0.8);
    }

    .btn-secondary {
      background: #1E293B;
      color: var(--text-main);
      border: 1px solid #334155;
    }

    .btn-secondary:hover {
      background: #334155;
    }

    /* Financial Tracking Status Bar */
    .status-bar-container {
      background: #0B1120;
      border-bottom: 1px solid var(--card-border);
      padding: 14px 28px;
    }

    .status-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr) 2fr;
      gap: 16px;
      align-items: center;
    }

    .metric-card {
      background: rgba(13, 20, 36, 0.7);
      border: 1px solid var(--card-border);
      padding: 12px 16px;
      border-radius: 8px;
      position: relative;
    }

    .metric-card.stolen { border-left: 4px solid var(--accent-red); }
    .metric-card.tracked { border-left: 4px solid var(--accent-green); }
    .metric-card.frozen { border-left: 4px solid var(--accent-cyan); }
    .metric-card.pending { border-left: 4px solid var(--accent-orange); }

    .metric-label {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      font-family: var(--font-mono);
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
    }

    .metric-val {
      font-size: 19px;
      font-weight: 800;
      font-family: var(--font-mono);
      letter-spacing: -0.5px;
    }

    .metric-card.stolen .metric-val { color: var(--accent-red); }
    .metric-card.tracked .metric-val { color: var(--accent-green); }
    .metric-card.frozen .metric-val { color: var(--accent-cyan); }
    .metric-card.pending .metric-val { color: var(--accent-orange); }

    .progress-box {
      background: rgba(13, 20, 36, 0.7);
      border: 1px solid var(--card-border);
      padding: 12px 16px;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
    }

    .progress-labels {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      font-family: var(--font-mono);
    }

    .progress-bar-bg {
      height: 10px;
      background: #1E293B;
      border-radius: 5px;
      overflow: hidden;
      display: flex;
    }

    .progress-bar-tracked {
      height: 100%;
      background: linear-gradient(90deg, #00E676, #00E5FF);
      transition: width 0.6s ease;
    }

    .progress-bar-pending {
      height: 100%;
      background: var(--accent-orange);
      transition: width 0.6s ease;
    }

    /* Main Container */
    main {
      padding: 20px 28px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 1920px;
      margin: 0 auto;
      width: 100%;
    }

    /* Action & Search Strip */
    .action-strip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 12px 20px;
      gap: 16px;
      flex-wrap: wrap;
    }

    .search-group {
      display: flex;
      align-items: center;
      background: #080D1A;
      border: 1px solid #334155;
      border-radius: 7px;
      padding: 4px 12px;
      flex: 1;
      max-width: 480px;
      gap: 8px;
    }

    .search-input {
      background: transparent;
      border: none;
      color: #FFFFFF;
      font-size: 13px;
      font-family: var(--font-sans);
      width: 100%;
      outline: none;
      padding: 6px 0;
    }

    .search-input::placeholder {
      color: #64748B;
    }

    .controls-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Format pill tags */
    .format-pills {
      display: flex;
      gap: 6px;
      align-items: center;
      font-size: 10.5px;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .pill {
      background: #111A2E;
      border: 1px solid #334155;
      padding: 2px 6px;
      border-radius: 4px;
      color: var(--accent-cyan);
    }

    /* Grid Layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    /* Card Panels */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .card-header {
      padding: 12px 18px;
      background: rgba(18, 28, 48, 0.6);
      border-bottom: 1px solid var(--card-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-title {
      font-size: 13.5px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #F1F5F9;
    }

    .card-body {
      padding: 18px;
      flex: 1;
    }

    /* Visual Graph Viewer */
    .graph-viewer {
      background: #080D1A;
      border-radius: 8px;
      border: 1px solid #1E293B;
      min-height: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .graph-viewer img {
      max-width: 100%;
      height: auto;
      border-radius: 6px;
      transition: transform 0.3s ease;
      cursor: zoom-in;
    }

    .graph-overlay-tools {
      position: absolute;
      bottom: 16px;
      right: 16px;
      display: flex;
      gap: 8px;
      background: rgba(13, 20, 36, 0.85);
      backdrop-filter: blur(8px);
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid #334155;
    }

    /* Table Styles */
    .data-table-container {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--card-border);
    }

    table.data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      text-align: left;
    }

    table.data-table th {
      background: #0F172A;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      padding: 10px 14px;
      border-bottom: 1px solid var(--card-border);
    }

    table.data-table td {
      padding: 10px 14px;
      border-bottom: 1px solid #1A2438;
      color: #E2E8F0;
    }

    table.data-table tr:hover td {
      background: rgba(30, 41, 59, 0.4);
    }

    .role-badge {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      font-family: var(--font-mono);
      text-transform: uppercase;
    }

    .role-victim { background: rgba(0, 230, 118, 0.15); color: var(--accent-green); border: 1px solid var(--accent-green); }
    .role-mule1 { background: rgba(255, 23, 68, 0.18); color: var(--accent-red); border: 1px solid var(--accent-red); }
    .role-mule2 { background: rgba(255, 145, 0, 0.18); color: var(--accent-orange); border: 1px solid var(--accent-orange); }
    .role-mule3 { background: rgba(245, 0, 87, 0.18); color: var(--accent-pink); border: 1px solid var(--accent-pink); }
    .role-cashout { background: rgba(0, 229, 255, 0.18); color: var(--accent-cyan); border: 1px solid var(--accent-cyan); }

    /* KYC Card Grid */
    .kyc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 16px;
    }

    .kyc-card {
      background: #090F1C;
      border: 1px solid #1E293B;
      border-radius: 8px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .kyc-card.victim-border { border-top: 3px solid var(--accent-green); }
    .kyc-card.mule1-border { border-top: 3px solid var(--accent-red); }
    .kyc-card.mule2-border { border-top: 3px solid var(--accent-orange); }
    .kyc-card.cashout-border { border-top: 3px solid var(--accent-cyan); }

    .kyc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 8px;
      border-bottom: 1px solid #1E293B;
    }

    .kyc-name {
      font-size: 14px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .kyc-prop {
      display: flex;
      justify-content: space-between;
      font-size: 11.5px;
      padding: 2px 0;
    }

    .kyc-prop .label {
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .kyc-prop .value {
      color: #E2E8F0;
      font-weight: 500;
      text-align: right;
    }

    /* Why Flagged Evidence Card Component */
    .why-flagged-box {
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid #334155;
      border-left: 4px solid var(--accent-red);
      border-radius: 8px;
      padding: 12px 14px;
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .why-flagged-box.suspicious {
      border-left-color: var(--accent-orange);
    }

    .why-flagged-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 6px;
      border-bottom: 1px solid #1E293B;
    }

    .why-flagged-title {
      font-size: 12px;
      font-weight: 700;
      color: #00E5FF;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .classification-tag {
      font-size: 10.5px;
      font-family: var(--font-mono);
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .class-high {
      background: rgba(255, 23, 68, 0.2);
      color: #FF1744;
      border: 1px solid #FF1744;
    }

    .class-suspicious {
      background: rgba(255, 145, 0, 0.2);
      color: #FF9100;
      border: 1px solid #FF9100;
    }

    .class-normal {
      background: rgba(0, 230, 118, 0.2);
      color: #00E676;
      border: 1px solid #00E676;
    }

    .evidence-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 11.5px;
      color: #F1F5F9;
      line-height: 1.45;
      padding: 3px 0;
    }

    .evidence-item strong {
      color: #FFE57F;
    }

    /* Modal dialog */
    .modal-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(4, 7, 14, 0.85);
      backdrop-filter: blur(8px);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-window {
      background: var(--card-bg);
      border: 1px solid #334155;
      border-radius: 12px;
      width: 100%;
      max-width: 850px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
      animation: modalIn 0.25s ease-out;
    }

    @keyframes modalIn {
      from { transform: scale(0.96); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-header {
      padding: 16px 22px;
      border-bottom: 1px solid var(--card-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-body {
      padding: 22px;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .modal-footer {
      padding: 14px 22px;
      border-top: 1px solid var(--card-border);
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .legal-notice-box {
      background: #060A12;
      border: 1px solid #1E293B;
      color: #94A3B8;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 14px;
      border-radius: 6px;
      white-space: pre-wrap;
      max-height: 380px;
      overflow-y: auto;
      line-height: 1.5;
    }

    /* Tab switcher */
    .tab-nav {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--card-border);
      padding: 0 20px;
      background: rgba(13, 20, 36, 0.4);
    }

    .tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 12.5px;
      font-weight: 600;
      padding: 12px 14px;
      cursor: pointer;
      position: relative;
    }

    .tab-btn.active {
      color: var(--accent-cyan);
    }

    .tab-btn.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--accent-cyan);
    }

    .tab-pane {
      display: none;
    }

    .tab-pane.active {
      display: block;
    }

    .rejection-item {
      background: rgba(255, 23, 68, 0.08);
      border: 1px solid rgba(255, 23, 68, 0.25);
      border-radius: 6px;
      padding: 10px 14px;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>

  <!-- Top Header -->
  <header>
    <div class="brand-group">
      <div class="brand-logo">TN</div>
      <div>
        <div class="brand-title">TRUST<span>NET</span></div>
        <div class="brand-subtitle">Cyber-Financial Intelligence & Multi-Hop Mule Platform</div>
      </div>
      <div class="badge-soc">SECURE SOC // 1930 & I4C INTEGRATED</div>

      <!-- Public View Link -->
      <div class="public-link-badge">
        <i data-lucide="globe" size="14" color="#00E5FF"></i>
        <span style="font-size: 11px; font-family: var(--font-mono); color: #00E5FF;">
          PUBLIC LINK: <a href="https://289a07079de23c.lhr.life" target="_blank" id="public-link-href" style="color: #FFFFFF; font-weight: 700; text-decoration: underline;">https://289a07079de23c.lhr.life</a>
        </span>
        <button class="btn btn-secondary" style="padding: 2px 7px; font-size: 10px;" onclick="copyPublicLink()">Copy</button>
      </div>
    </div>

    <div class="header-actions">
      <button class="btn btn-freeze" onclick="openFreezeModal()">
        <i data-lucide="shield-alert"></i> FREEZE ALL MULE ACCOUNTS
      </button>
      <button class="btn btn-secondary" onclick="openDoubleVerifModal()">
        <i data-lucide="git-compare"></i> DOUBLE VERIFICATION
      </button>
      <a href="/download/dossier.pdf" class="btn btn-primary" download>
        <i data-lucide="file-text"></i> EXPORT POLICE DOSSIER (PDF)
      </a>
    </div>
  </header>

  <!-- Financial Tracking Status Bar -->
  <div class="status-bar-container">
    <div class="status-grid">
      <!-- Total Stolen -->
      <div class="metric-card stolen">
        <div class="metric-label">
          <span>Total Fraud Loss</span>
          <i data-lucide="alert-circle" size="14"></i>
        </div>
        <div class="metric-val" id="metric-stolen">₹19,00,000</div>
      </div>

      <!-- Total Tracked -->
      <div class="metric-card tracked">
        <div class="metric-label">
          <span>Funds Tracked</span>
          <i data-lucide="check-circle" size="14"></i>
        </div>
        <div class="metric-val" id="metric-tracked">₹19,00,000</div>
      </div>

      <!-- Total Frozen -->
      <div class="metric-card frozen">
        <div class="metric-label">
          <span>Lien / Frozen Sum</span>
          <i data-lucide="lock" size="14"></i>
        </div>
        <div class="metric-val" id="metric-frozen">₹0</div>
      </div>

      <!-- Pending to Track -->
      <div class="metric-card pending">
        <div class="metric-label">
          <span>Pending Recovery</span>
          <i data-lucide="clock" size="14"></i>
        </div>
        <div class="metric-val" id="metric-pending">₹0</div>
      </div>

      <!-- Tracking Progress Bar -->
      <div class="progress-box">
        <div class="progress-labels">
          <span id="progress-status-text">DISPERSAL TRACKING: 100% RECONCILED</span>
          <span id="progress-percent" style="color: var(--accent-cyan); font-weight: 700;">100% Tracked</span>
        </div>
        <div class="progress-bar-bg">
          <div class="progress-bar-tracked" id="bar-tracked" style="width: 100%;"></div>
          <div class="progress-bar-pending" id="bar-pending" style="width: 0%;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Work Area -->
  <main>

    <!-- Ingestion, Enquiry & Actions Strip -->
    <div class="action-strip">
      <!-- Search / Enquiry Input -->
      <div class="search-group">
        <i data-lucide="search" size="16" color="#64748B"></i>
        <input type="text" id="enquiry-input" class="search-input" placeholder="Search by Txn ID, Account No, UPI ID, Phone, Name, or IP..." onkeyup="handleEnquirySearch(event)">
      </div>

      <!-- Ingestion & Filter Controls -->
      <div class="controls-group">
        <!-- Supported Format Pills -->
        <div class="format-pills">
          <span>SUPPORTS:</span>
          <span class="pill">PDF Statements</span>
          <span class="pill">PNG Receipts</span>
          <span class="pill">CSV / JSON (500MB)</span>
        </div>

        <!-- File upload button supporting PDF, PNG, JPG, CSV, JSON up to 500MB -->
        <input type="file" id="file-upload" accept=".pdf,.png,.jpg,.jpeg,.csv,.json" style="display:none;" onchange="handleFileUpload(event)">
        <button class="btn btn-primary" onclick="document.getElementById('file-upload').click()">
          <i data-lucide="upload-cloud"></i> UPLOAD (PDF / PNG / CSV / JSON)
        </button>

        <!-- Filter invalid records -->
        <button class="btn btn-secondary" onclick="openFilterReportModal()">
          <i data-lucide="filter"></i> FILTER & CLEANSE REPORT
        </button>

        <!-- Re-run Trace -->
        <button class="btn btn-secondary" onclick="runTrace()">
          <i data-lucide="refresh-cw"></i> RE-TRACE NETWORK
        </button>
      </div>
    </div>

    <!-- Enquiry Live Results Drawer -->
    <div id="enquiry-results-card" class="card" style="display: none;">
      <div class="card-header">
        <div class="card-title">
          <i data-lucide="search" size="16" color="#00E5FF"></i> FORENSIC ENQUIRY RESULTS (<span id="enquiry-match-count">0</span> Matches Found)
        </div>
        <button class="btn btn-secondary" style="padding: 4px 8px;" onclick="closeEnquiry()">Close</button>
      </div>
      <div class="card-body" id="enquiry-results-body">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Tabs Container for Visual Graph and Flowchart -->
    <div class="card full-width">
      <div class="tab-nav">
        <button class="tab-btn active" onclick="switchTab('graph-tab', this)">
          <i data-lucide="network" size="14"></i> MULTI-TIER MULE GRAPH
        </button>
        <button class="tab-btn" onclick="switchTab('flowchart-tab', this)">
          <i data-lucide="workflow" size="14"></i> FORENSIC FLOWCHART
        </button>
        <button class="tab-btn" onclick="switchTab('mules-tab', this)">
          <i data-lucide="users" size="14"></i> MULE NETWORK DIRECTORY & EVIDENCE
        </button>
      </div>

      <!-- Tab 1: Graph Viewer -->
      <div id="graph-tab" class="tab-pane active card-body">
        <div class="graph-viewer">
          <img id="graph-img" src="/download/graph.png" alt="TrustNet Multi-Hop Mule Detection Graph">
          <div class="graph-overlay-tools">
            <a href="/download/graph.png" download class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;">
              <i data-lucide="image" size="12"></i> PNG
            </a>
            <a href="/download/graph.pdf" download class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;">
              <i data-lucide="file" size="12"></i> PDF
            </a>
            <button class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;" onclick="zoomImage('graph-img')">
              <i data-lucide="maximize-2" size="12"></i> Zoom
            </button>
          </div>
        </div>
      </div>

      <!-- Tab 2: Flowchart Viewer -->
      <div id="flowchart-tab" class="tab-pane card-body">
        <div class="graph-viewer">
          <img id="flowchart-img" src="/download/flowchart.png" alt="TrustNet Investigation Flowchart">
          <div class="graph-overlay-tools">
            <a href="/download/flowchart.png" download class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;">
              <i data-lucide="image" size="12"></i> PNG
            </a>
            <a href="/download/flowchart.pdf" download class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;">
              <i data-lucide="file" size="12"></i> PDF
            </a>
            <button class="btn btn-secondary" style="font-size:11px; padding: 4px 8px;" onclick="zoomImage('flowchart-img')">
              <i data-lucide="maximize-2" size="12"></i> Zoom
            </button>
          </div>
        </div>
      </div>

      <!-- Tab 3: Detailed Mule List with Why Flagged? Integration -->
      <div id="mules-tab" class="tab-pane card-body">
        <div class="data-table-container">
          <table class="data-table" id="all-entities-table">
            <thead>
              <tr>
                <th>Tier / Role</th>
                <th>Classification</th>
                <th>Account Holder Name</th>
                <th>Bank Account No</th>
                <th>IFSC & Bank</th>
                <th>UPI ID</th>
                <th>Inflow (INR)</th>
                <th>Branches</th>
                <th>Status</th>
                <th>Explainable Evidence</th>
              </tr>
            </thead>
            <tbody id="entities-table-body">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Entities Dossier Grid: Victim, Mule 1 with Why Flagged Evidence Panel -->
    <div class="dashboard-grid full-width">
      <!-- Section A: Primary Victim Dossier -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i data-lucide="user-x" size="16" color="#00E676"></i> VICTIM ACCOUNT DETAILS
          </div>
          <span class="role-badge role-victim">ORIGIN VICTIM</span>
        </div>
        <div class="card-body" id="victim-dossier-body">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Section B: Mule 1 Primary Collector Dossier with Why Flagged Panel -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i data-lucide="alert-triangle" size="16" color="#FF1744"></i> MULE 1 DETAILS (PRIMARY COLLECTOR)
          </div>
          <span class="role-badge role-mule1">LAYER 1 (L1)</span>
        </div>
        <div class="card-body" id="mule1-dossier-body">
          <!-- Dynamically populated including Why Flagged Evidence -->
        </div>
      </div>
    </div>

    <!-- Section C: Cash-Out Terminals (IP, Geolocation, Device IDs) -->
    <div class="card full-width">
      <div class="card-header">
        <div class="card-title">
          <i data-lucide="map-pin" size="16" color="#00E5FF"></i> CASH-OUT EXIT POINTS & DEVICE / IP FORENSICS
        </div>
        <span class="role-badge role-cashout">TERMINAL LAYER 4 (L4)</span>
      </div>
      <div class="card-body">
        <div class="data-table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Terminal Type</th>
                <th>Cashed Amount (INR)</th>
                <th>Device ID / ATM ID</th>
                <th>Terminal IP Address</th>
                <th>Physical Location & Coordinates</th>
                <th>Timestamp</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="cashouts-table-body">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>

  <!-- Modal 1: Dedicated Why Flagged Evidence Modal -->
  <div class="modal-backdrop" id="evidence-modal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="card-title">
          <i data-lucide="shield-alert" size="18" color="#FF1744"></i> EXPLAINABLE EVIDENCE // WHY FLAGGED?
        </div>
        <button class="btn btn-secondary" onclick="closeModal('evidence-modal')">✕</button>
      </div>
      <div class="modal-body" id="evidence-modal-body">
        <!-- Dynamically injected evidence -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('evidence-modal')">Close</button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Double Verification Modal -->
  <div class="modal-backdrop" id="double-verif-modal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="card-title">
          <i data-lucide="git-compare" size="18" color="#00E5FF"></i> BIDIRECTIONAL DOUBLE VERIFICATION REPORT
        </div>
        <button class="btn btn-secondary" onclick="closeModal('double-verif-modal')">✕</button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(0, 229, 255, 0.08); border: 1px solid rgba(0, 229, 255, 0.3); border-radius: 8px; padding: 14px;">
          <div style="font-weight: 700; color: #00E5FF; margin-bottom: 4px; font-size: 14px;" id="dv-verdict-title">
            VERDICT: MULTI-VICTIM SYNDICATE DETECTED
          </div>
          <div style="font-size: 12px; color: #E2E8F0;" id="dv-verdict-text">
            Double Verification performed: Top-to-Bottom check followed all victim transfers. Bottom-to-Top reverse trace from cashouts discovered multiple independent victim sources feeding the same mule ring.
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="background: #090F1D; border: 1px solid #1E293B; border-radius: 8px; padding: 14px;">
            <div style="font-weight: 700; font-size: 12px; color: var(--accent-green); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <i data-lucide="arrow-down" size="14"></i> 1. TOP-TO-BOTTOM TRACE (FORWARD)
            </div>
            <div id="dv-forward-list" style="font-size: 11px; font-family: var(--font-mono); color: #CBD5E1; max-height: 220px; overflow-y: auto;"></div>
          </div>

          <div style="background: #090F1D; border: 1px solid #1E293B; border-radius: 8px; padding: 14px;">
            <div style="font-weight: 700; font-size: 12px; color: var(--accent-cyan); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <i data-lucide="arrow-up" size="14"></i> 2. BOTTOM-TO-TOP TRACE (REVERSE)
            </div>
            <div id="dv-reverse-list" style="font-size: 11px; font-family: var(--font-mono); color: #CBD5E1; max-height: 220px; overflow-y: auto;"></div>
          </div>
        </div>

        <div id="syndicate-victims-box">
          <div style="font-weight: 700; font-size: 12px; color: #FF9100; margin-bottom: 6px;">
            IDENTIFIED CONVERGENT VICTIMS IN THIS MULE RING:
          </div>
          <div id="syndicate-victims-list" style="display: flex; gap: 10px; flex-wrap: wrap;"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('double-verif-modal')">Close</button>
      </div>
    </div>
  </div>

  <!-- Modal 3: Batch Freeze Notice Modal -->
  <div class="modal-backdrop" id="freeze-modal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="card-title">
          <i data-lucide="shield-alert" size="18" color="#FF1744"></i> SECTION 102/91 Cr.P.C. BATCH DEBIT FREEZE NOTICE
        </div>
        <button class="btn btn-secondary" onclick="closeModal('freeze-modal')">✕</button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(255, 23, 68, 0.1); border: 1px solid rgba(255, 23, 68, 0.4); border-radius: 8px; padding: 12px; font-size: 12px; color: #FFFFFF; display: flex; align-items: center; gap: 10px;">
          <i data-lucide="check-circle" size="20" color="#FF1744"></i>
          <div>
            <strong>ALL MULE ACCOUNTS SUCCESSFULLY FROZEN:</strong>
            <span id="freeze-count-text">10 Suspect Accounts Marked for Immediate Debit Lien.</span>
          </div>
        </div>
        <div class="legal-notice-box" id="freeze-notice-content"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="copyFreezeNotice()">
          <i data-lucide="copy" size="14"></i> Copy Statutory Notice
        </button>
        <button class="btn btn-primary" onclick="closeModal('freeze-modal')">Done</button>
      </div>
    </div>
  </div>

  <!-- Modal 4: Filter & Cleansing Report Modal -->
  <div class="modal-backdrop" id="filter-modal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="card-title">
          <i data-lucide="filter" size="18" color="#00E5FF"></i> DATASET VALIDATION & CLEANSING AUDIT
        </div>
        <button class="btn btn-secondary" onclick="closeModal('filter-modal')">✕</button>
      </div>
      <div class="modal-body">
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;">
          <div class="metric-card">
            <div class="metric-label">Total Raw Records</div>
            <div class="metric-val" id="raw-records-count">14</div>
          </div>
          <div class="metric-card tracked">
            <div class="metric-label">Clean Ingested</div>
            <div class="metric-val" id="clean-records-count">12</div>
          </div>
          <div class="metric-card stolen">
            <div class="metric-label">Invalid Rejected</div>
            <div class="metric-val" id="rejected-records-count">2</div>
          </div>
          <div class="metric-card frozen">
            <div class="metric-label">Quality Score</div>
            <div class="metric-val" id="quality-score-val">85.7%</div>
          </div>
        </div>

        <div style="margin-top: 10px;">
          <h4 style="font-size: 13px; font-weight: 700; margin-bottom: 8px; color: var(--accent-red);">
            REJECTED RECORDS & INTEGRITY REASONS:
          </h4>
          <div id="rejected-records-list"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('filter-modal')">Close</button>
      </div>
    </div>
  </div>

  <script>
    let globalEntities = {};
    let globalTransactions = [];
    let globalSummary = {};
    let globalDV = {};
    let globalFilter = {};
    let globalWhyFlagged = {};

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      fetchAllData();
    });

    async function fetchAllData() {
      try {
        const [sumRes, entRes, txRes, statRes, dvRes, fltRes, wfRes] = await Promise.all([
          fetch('/api/summary').then(r => r.json()),
          fetch('/api/entities').then(r => r.json()),
          fetch('/api/transactions').then(r => r.json()),
          fetch('/api/status').then(r => r.json()),
          fetch('/api/double-verification').then(r => r.json()),
          fetch('/api/filter-stats').then(r => r.json()),
          fetch('/api/why-flagged').then(r => r.json())
        ]);

        globalSummary = sumRes;
        globalEntities = entRes;
        globalTransactions = txRes;
        globalDV = dvRes;
        globalFilter = fltRes;
        globalWhyFlagged = wfRes;

        renderStatusBar(statRes);
        renderEntitiesTable(entRes, wfRes);
        renderVictimDossier(entRes, sumRes.victim_accounts);
        renderMule1Dossier(entRes, wfRes);
        renderCashoutTerminals(entRes);
        renderFilterReport(fltRes);
        renderDoubleVerifModal(dvRes);
        lucide.createIcons();
      } catch (err) {
        console.error("Failed to load dashboard data:", err);
      }
    }

    function renderStatusBar(data) {
      document.getElementById('metric-stolen').innerText = `₹${(data.total_stolen_inr || 0).toLocaleString('en-IN')}`;
      document.getElementById('metric-tracked').innerText = `₹${(data.total_tracked_inr || 0).toLocaleString('en-IN')}`;
      document.getElementById('metric-frozen').innerText = `₹${(data.total_frozen_inr || 0).toLocaleString('en-IN')}`;
      document.getElementById('metric-pending').innerText = `₹${(data.total_pending_inr || 0).toLocaleString('en-IN')}`;

      document.getElementById('bar-tracked').style.width = `${data.tracked_percent || 100}%`;
      document.getElementById('bar-pending').style.width = `${data.pending_percent || 0}%`;
      document.getElementById('progress-percent').innerText = `${data.tracked_percent || 100}% Tracked`;
      document.getElementById('progress-status-text').innerText = `STATUS: ${data.status_label || 'NORMAL'}`;
    }

    function generateWhyFlaggedHtml(accountNumber, wfData) {
      const ev = (wfData && wfData[accountNumber]) || null;
      if (!ev || !ev.is_flagged) return '';

      let classClass = 'class-high';
      if (ev.classification_level === 'SUSPICIOUS') classClass = 'class-suspicious';
      else if (ev.classification_level === 'NORMAL') classClass = 'class-normal';

      let itemsHtml = '';
      ev.evidence_points.forEach(pt => {
        itemsHtml += `
          <div class="evidence-item">
            <span style="font-size: 13px;">${pt.icon}</span>
            <span><strong>${pt.title}:</strong> ${pt.text}</span>
          </div>
        `;
      });

      return `
        <div class="why-flagged-box ${ev.classification_level === 'SUSPICIOUS' ? 'suspicious' : ''}">
          <div class="why-flagged-header">
            <div class="why-flagged-title">
              <i data-lucide="shield-alert" size="14" color="#00E5FF"></i> Why Flagged?
            </div>
            <span class="classification-tag ${classClass}">Classification: ${ev.classification}</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            ${itemsHtml}
          </div>
        </div>
      `;
    }

    function renderVictimDossier(entities, victimAccs) {
      const vAcc = (victimAccs && victimAccs.length > 0) ? victimAccs[0] : Object.keys(entities)[0];
      const v = entities[vAcc] || {};

      const outTx = v.outbound_txns || [];
      const m1Acc = outTx.length > 0 ? outTx[0].receiver_account : "91802004918231";
      const m1TxId = outTx.length > 0 ? outTx[0].transaction_id : "TXN9928172901";
      const m1Time = outTx.length > 0 ? outTx[0].timestamp : "2026-09-28 09:15:22";

      const html = `
        <div class="kyc-card victim-border">
          <div class="kyc-header">
            <div>
              <div class="kyc-name">${v.name || 'Sunita Ramesh Verma'}</div>
              <div style="font-size: 11px; color: var(--text-muted);">${v.age || 48} Yrs, ${v.gender || 'Female'}</div>
            </div>
            <span class="role-badge role-victim">VICTIM</span>
          </div>
          <div class="kyc-prop"><span class="label">Bank Acc No:</span><span class="value" style="font-family: var(--font-mono);">${v.account_number}</span></div>
          <div class="kyc-prop"><span class="label">Bank & IFSC:</span><span class="value">${v.bank_name} (${v.ifsc})</span></div>
          <div class="kyc-prop"><span class="label">UPI ID:</span><span class="value" style="color: var(--accent-cyan);">${v.upi_id}</span></div>
          <div class="kyc-prop"><span class="label">Phone:</span><span class="value">${v.phone}</span></div>
          <div class="kyc-prop"><span class="label">Address:</span><span class="value" style="max-width: 220px;">${v.address}</span></div>
          <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed #334155;">
            <div class="kyc-prop"><span class="label">Amount Taken by Mule 1:</span><span class="value" style="color: var(--accent-red); font-weight:700;">₹${(v.total_sent || 1500000).toLocaleString('en-IN')}</span></div>
            <div class="kyc-prop"><span class="label">Recipient Mule 1 Acc:</span><span class="value" style="font-family: var(--font-mono);">${m1Acc}</span></div>
            <div class="kyc-prop"><span class="label">Txn ID to Mule 1:</span><span class="value" style="font-family: var(--font-mono); color: #FFE57F;">${m1TxId}</span></div>
            <div class="kyc-prop"><span class="label">Timestamp:</span><span class="value">${m1Time}</span></div>
          </div>
        </div>
      `;
      document.getElementById('victim-dossier-body').innerHTML = html;
    }

    function renderMule1Dossier(entities, wfData) {
      let m1 = null;
      for (const [acc, ent] of Object.entries(entities)) {
        if (ent.role === "Mule 1" || ent.layer === "L1") {
          m1 = ent;
          break;
        }
      }
      if (!m1) {
        m1 = entities["91802004918231"] || {};
      }

      const outTx = m1.outbound_txns || [];
      const childCount = m1.child_accounts_count || outTx.length;

      let branchesHtml = '';
      outTx.forEach((tx) => {
        branchesHtml += `
          <div style="font-size: 11px; padding: 4px 0; border-bottom: 1px solid #1E293B; display: flex; justify-content: space-between;">
            <span>To Acc: <strong>${tx.receiver_account}</strong> (${tx.receiver_name || 'Downstream Mule'})</span>
            <span style="color: var(--accent-orange); font-family: var(--font-mono); font-weight: 700;">₹${Number(tx.amount).toLocaleString('en-IN')} @ ${tx.timestamp.split(' ')[1] || tx.timestamp}</span>
          </div>
        `;
      });

      // Generate dynamic Why Flagged? evidence panel for Mule 1
      const whyFlaggedHtml = generateWhyFlaggedHtml(m1.account_number, wfData);

      const html = `
        <div class="kyc-card mule1-border">
          <div class="kyc-header">
            <div>
              <div class="kyc-name">${m1.name || 'Aakash Deep Sharma'}</div>
              <div style="font-size: 11px; color: var(--text-muted);">${m1.age || 26} Yrs, ${m1.gender || 'Male'}</div>
            </div>
            <span class="role-badge role-mule1">MULE 1 (L1)</span>
          </div>
          <div class="kyc-prop"><span class="label">Account No:</span><span class="value" style="font-family: var(--font-mono);">${m1.account_number}</span></div>
          <div class="kyc-prop"><span class="label">Bank & IFSC:</span><span class="value">${m1.bank_name} (${m1.ifsc})</span></div>
          <div class="kyc-prop"><span class="label">UPI ID:</span><span class="value" style="color: var(--accent-cyan);">${m1.upi_id}</span></div>
          <div class="kyc-prop"><span class="label">Phone:</span><span class="value">${m1.phone}</span></div>
          <div class="kyc-prop"><span class="label">Address:</span><span class="value" style="max-width: 220px;">${m1.address}</span></div>
          <div class="kyc-prop"><span class="label">Total Received from Victim:</span><span class="value" style="color: var(--accent-red); font-weight:700;">₹${(m1.total_received || 1500000).toLocaleString('en-IN')}</span></div>
          
          <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed #334155;">
            <div style="font-size: 11px; font-weight: 700; color: #FFE57F; margin-bottom: 6px;">
              DISPERSAL BRANCHES (${childCount} ACCOUNTS LINKED):
            </div>
            ${branchesHtml || '<div style="font-size:11px; color:#64748B;">No downstream branches recorded.</div>'}
          </div>

          <!-- Dynamic Explainable Evidence Card -->
          ${whyFlaggedHtml}
        </div>
      `;
      document.getElementById('mule1-dossier-body').innerHTML = html;
    }

    function renderCashoutTerminals(entities) {
      const tbody = document.getElementById('cashouts-table-body');
      tbody.innerHTML = '';

      for (const [acc, ent] of Object.entries(entities)) {
        if (ent.role === "Cash-Out Terminal" || ent.layer === "L4_CashOut" || acc.startsWith("ATM-") || acc.startsWith("CRYPTO-") || acc.startsWith("POS-")) {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong style="color: var(--accent-cyan);">${ent.name || acc}</strong></td>
            <td style="font-family: var(--font-mono); font-weight: 700; color: var(--accent-green);">₹${(ent.total_received || 0).toLocaleString('en-IN')}</td>
            <td style="font-family: var(--font-mono);">${ent.device_id || 'ATM-NCR-401'}</td>
            <td><span style="font-family: var(--font-mono); color: #FFE57F; background: #080D1A; padding: 2px 6px; border-radius: 4px;">${ent.ip_address || '182.74.92.11'}</span></td>
            <td>${ent.geo_location || 'Karol Bagh Market, New Delhi (28.6517° N, 77.1906° E)'}</td>
            <td style="font-family: var(--font-mono); font-size: 11px;">${(ent.inbound_txns && ent.inbound_txns[0]) ? ent.inbound_txns[0].timestamp : '2026-09-28 10:14:35'}</td>
            <td><button class="btn btn-secondary" style="padding: 2px 6px; font-size: 10px;" onclick="showWhyFlaggedModal('${acc}')">Why Flagged?</button></td>
          `;
          tbody.appendChild(tr);
        }
      }
    }

    function renderEntitiesTable(entities, wfData) {
      const tbody = document.getElementById('entities-table-body');
      tbody.innerHTML = '';

      for (const [acc, ent] of Object.entries(entities)) {
        const tr = document.createElement('tr');
        let badgeClass = "role-mule2";
        if (ent.role === "Victim") badgeClass = "role-victim";
        else if (ent.role === "Mule 1") badgeClass = "role-mule1";
        else if (ent.role === "Cash-Out Terminal") badgeClass = "role-cashout";

        const ev = wfData[acc] || {};
        const classLabel = ev.classification || (ent.role === "Victim" ? "Normal" : "High-Risk");
        let classBadge = 'class-high';
        if (classLabel === 'Suspicious') classBadge = 'class-suspicious';
        else if (classLabel.includes('Normal') || classLabel.includes('Protected')) classBadge = 'class-normal';

        tr.innerHTML = `
          <td><span class="role-badge ${badgeClass}">${ent.role}</span></td>
          <td><span class="classification-tag ${classBadge}">${classLabel}</span></td>
          <td><strong>${ent.name}</strong></td>
          <td style="font-family: var(--font-mono);">${acc}</td>
          <td>${ent.bank_name}<br><span style="font-size: 10px; color: var(--text-muted);">${ent.ifsc}</span></td>
          <td style="color: var(--accent-cyan); font-family: var(--font-mono);">${ent.upi_id}</td>
          <td style="font-family: var(--font-mono); font-weight: 700; color: var(--accent-green);">₹${(ent.total_received || 0).toLocaleString('en-IN')}</td>
          <td>${ent.child_accounts_count || 0} Accounts</td>
          <td><span style="color: ${ent.is_frozen ? 'var(--accent-cyan)' : 'var(--accent-orange)'}; font-weight:700;">${ent.is_frozen ? 'FROZEN (LIEN)' : 'ACTIVE'}</span></td>
          <td>
            ${ent.role !== 'Victim' ? `<button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="showWhyFlaggedModal('${acc}')"><i data-lucide="shield-alert" size="12"></i> Why Flagged?</button>` : '<span style="color: var(--accent-green); font-size:11px;">Protected</span>'}
          </td>
        `;
        tbody.appendChild(tr);
      }
    }

    function showWhyFlaggedModal(acc) {
      const ev = globalWhyFlagged[acc] || null;
      const modal = document.getElementById('evidence-modal');
      const body = document.getElementById('evidence-modal-body');

      if (!ev) {
        body.innerHTML = `<div>No evidence profile available for account ${acc}.</div>`;
        modal.classList.add('active');
        return;
      }

      let classClass = 'class-high';
      if (ev.classification_level === 'SUSPICIOUS') classClass = 'class-suspicious';
      else if (ev.classification_level === 'NORMAL') classClass = 'class-normal';

      let pointsHtml = '';
      if (ev.evidence_points && ev.evidence_points.length > 0) {
        ev.evidence_points.forEach(pt => {
          pointsHtml += `
            <div style="background: #090F1E; border: 1px solid #1E293B; border-radius: 8px; padding: 12px; display: flex; align-items: flex-start; gap: 10px;">
              <span style="font-size: 18px;">${pt.icon}</span>
              <div>
                <div style="font-weight: 700; font-size: 12.5px; color: #FFE57F; margin-bottom: 2px;">${pt.title}</div>
                <div style="font-size: 12px; color: #E2E8F0; line-height: 1.4;">${pt.text}</div>
              </div>
            </div>
          `;
        });
      } else {
        pointsHtml = '<div style="color: var(--text-muted); font-size: 12px;">No risk signals triggered. Account classified as Normal / Protected.</div>';
      }

      body.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; background: #080D1A; padding: 14px; border-radius: 8px; border: 1px solid #1E293B;">
          <div>
            <div style="font-size: 16px; font-weight: 700; color: #FFFFFF;">${ev.holder_name || 'Account Holder'}</div>
            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--accent-cyan); margin-top: 2px;">A/C: ${ev.account_number}</div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); text-transform: uppercase;">System Classification</div>
            <span class="classification-tag ${classClass}" style="font-size: 12px; padding: 4px 10px; margin-top: 4px; display: inline-block;">
              Classification: ${ev.classification}
            </span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 6px;">
          <h4 style="font-size: 13px; font-weight: 700; color: #00E5FF; display: flex; align-items: center; gap: 6px;">
            <i data-lucide="shield-alert" size="15"></i> Explainable Risk Signals (${ev.evidence_count || 0} Triggers)
          </h4>
          ${pointsHtml}
        </div>
      `;

      modal.classList.add('active');
      lucide.createIcons();
    }

    function renderFilterReport(filterStats) {
      document.getElementById('raw-records-count').innerText = filterStats.total_raw || 14;
      document.getElementById('clean-records-count').innerText = filterStats.clean_count || 12;
      document.getElementById('rejected-records-count').innerText = filterStats.rejected_count || 2;
      document.getElementById('quality-score-val').innerText = `${filterStats.quality_score_percent || 85.7}%`;

      const rejList = document.getElementById('rejected-records-list');
      rejList.innerHTML = '';
      const samples = filterStats.sample_rejections || [];
      if (samples.length === 0) {
        rejList.innerHTML = '<div style="color: var(--accent-green); font-size: 12px;">Zero invalid records found. 100% data integrity verified.</div>';
      } else {
        samples.forEach(s => {
          const div = document.createElement('div');
          div.className = 'rejection-item';
          div.innerHTML = `
            <div style="font-weight: 700; font-size: 11px; color: #FF1744;">Row #${s.row_index}: Rejected due to ${s.reasons.length} errors</div>
            <div style="font-size: 11px; color: #CBD5E1; margin-top: 2px;">${s.reasons.join(' | ')}</div>
            <div style="font-size: 10px; font-family: var(--font-mono); color: #64748B; margin-top: 4px;">Txn ID: ${s.record.transaction_id || 'NULL'} | Sender: ${s.record.sender_account || 'NULL'}</div>
          `;
          rejList.appendChild(div);
        });
      }
    }

    function renderDoubleVerifModal(dv) {
      document.getElementById('dv-verdict-title').innerText = `VERDICT: ${dv.verdict_status || '100% RECONCILED'}`;
      document.getElementById('dv-verdict-text').innerText = dv.explanation || '';

      const fwd = document.getElementById('dv-forward-list');
      fwd.innerHTML = '';
      (dv.forward_steps || []).forEach(st => {
        const item = document.createElement('div');
        item.style.padding = '4px 0';
        item.style.borderBottom = '1px dashed #1E293B';
        item.innerHTML = `Step ${st.step_number}: <strong>${st.role}</strong> (${st.account_number}) - ₹${(st.incoming_amount || st.total_outbound_amount || 0).toLocaleString('en-IN')}`;
        fwd.appendChild(item);
      });

      const rev = document.getElementById('dv-reverse-list');
      rev.innerHTML = '';
      (dv.reverse_steps || []).forEach(st => {
        const item = document.createElement('div');
        item.style.padding = '4px 0';
        item.style.borderBottom = '1px dashed #1E293B';
        item.innerHTML = `Rev Hop ${st.reverse_hop}: <strong>${st.role}</strong> (${st.account_number}) - Sources: ${st.inbound_sources_count}`;
        rev.appendChild(item);
      });

      const vBox = document.getElementById('syndicate-victims-list');
      vBox.innerHTML = '';
      const victims = dv.all_victims || [];
      victims.forEach(v => {
        const vBadge = document.createElement('div');
        vBadge.style.background = '#0F172A';
        vBadge.style.border = '1px solid #FF9100';
        vBadge.style.padding = '6px 10px';
        vBadge.style.borderRadius = '6px';
        vBadge.style.fontSize = '11px';
        vBadge.innerHTML = `<strong>${v.name}</strong> (A/C: ${v.account_number})<br><span style="color:#FF9100;">Loss: ₹${(v.amount_defrauded || 0).toLocaleString('en-IN')}</span>`;
        vBox.appendChild(vBadge);
      });
    }

    async function handleFileUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 500 * 1024 * 1024) {
        alert("File size exceeds 500MB maximum limit.");
        return;
      }

      const formData = new FormData();
      formData.append("file", file);

      try {
        const res = await fetch("/api/upload", {
          method: "POST",
          body: formData
        });
        const data = await res.json();
        if (data.status === "SUCCESS") {
          alert(`Successfully ingested ${file.name}. Processed: ${data.message}`);
          await fetchAllData();
          reloadVisuals();
        } else {
          alert("Upload failed: " + (data.error || "Unknown error"));
        }
      } catch (err) {
        alert("Error uploading file: " + err);
      }
    }

    async function openFreezeModal() {
      try {
        const res = await fetch("/api/freeze-all", { method: "POST" });
        const data = await res.json();
        document.getElementById('freeze-count-text').innerText = `${data.total_accounts_frozen} Suspect Accounts Frozen (Total Lien: ₹${data.total_amount_lien.toLocaleString('en-IN')}).`;
        document.getElementById('freeze-notice-content').innerText = data.legal_notice_text;
        document.getElementById('freeze-modal').classList.add('active');
        await fetchAllData();
      } catch (err) {
        alert("Error executing freeze: " + err);
      }
    }

    function openDoubleVerifModal() {
      document.getElementById('double-verif-modal').classList.add('active');
    }

    function openFilterReportModal() {
      document.getElementById('filter-modal').classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function copyFreezeNotice() {
      const txt = document.getElementById('freeze-notice-content').innerText;
      navigator.clipboard.writeText(txt).then(() => {
        alert("Section 102/91 CrPC Police Requisition Notice copied to clipboard.");
      });
    }

    function copyPublicLink() {
      const link = document.getElementById('public-link-href').innerText;
      navigator.clipboard.writeText(link).then(() => {
        alert("Public View Link copied to clipboard:\n" + link);
      });
    }

    async function handleEnquirySearch(e) {
      const q = e.target.value.trim();
      if (!q) {
        document.getElementById('enquiry-results-card').style.display = 'none';
        return;
      }

      if (e.key === 'Enter' || q.length >= 3) {
        const res = await fetch(`/api/enquiry?q=${encodeURIComponent(q)}`).then(r => r.json());
        renderEnquiryResults(res);
      }
    }

    function renderEnquiryResults(data) {
      const card = document.getElementById('enquiry-results-card');
      const body = document.getElementById('enquiry-results-body');
      document.getElementById('enquiry-match-count').innerText = data.matches_count;
      body.innerHTML = '';

      if (data.matches_count === 0) {
        body.innerHTML = '<div style="color: var(--text-muted); font-size: 12px;">No matching accounts or transactions found for query.</div>';
      } else {
        const grid = document.createElement('div');
        grid.className = 'kyc-grid';

        data.entities.forEach(ent => {
          const whyFlaggedHtml = generateWhyFlaggedHtml(ent.account_number, globalWhyFlagged);

          const div = document.createElement('div');
          div.className = 'kyc-card mule2-border';
          div.innerHTML = `
            <div class="kyc-header">
              <div>
                <div class="kyc-name">${ent.name}</div>
                <div style="font-size: 11px; color: var(--text-muted);">${ent.role} (${ent.layer})</div>
              </div>
              <span class="role-badge role-mule2">RISK: ${ent.risk_score || 85}</span>
            </div>
            <div class="kyc-prop"><span class="label">Acc No:</span><span class="value" style="font-family: var(--font-mono);">${ent.account_number}</span></div>
            <div class="kyc-prop"><span class="label">Bank/IFSC:</span><span class="value">${ent.bank_name} (${ent.ifsc})</span></div>
            <div class="kyc-prop"><span class="label">UPI ID:</span><span class="value" style="color: var(--accent-cyan);">${ent.upi_id}</span></div>
            <div class="kyc-prop"><span class="label">Phone:</span><span class="value">${ent.phone}</span></div>
            <div class="kyc-prop"><span class="label">Total Inflow:</span><span class="value" style="color: var(--accent-green);">₹${(ent.total_received || 0).toLocaleString('en-IN')}</span></div>
            <div class="kyc-prop"><span class="label">Status:</span><span class="value" style="color: ${ent.is_frozen ? 'var(--accent-cyan)' : 'var(--accent-orange)'};">${ent.is_frozen ? 'DEBIT FROZEN' : 'ACTIVE'}</span></div>
            ${whyFlaggedHtml}
          `;
          grid.appendChild(div);
        });

        body.appendChild(grid);
      }
      card.style.display = 'flex';
      lucide.createIcons();
    }

    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(tabId).classList.add('active');
      lucide.createIcons();
    }

    function reloadVisuals() {
      const ts = new Date().getTime();
      document.getElementById('graph-img').src = `/download/graph.png?t=${ts}`;
      document.getElementById('flowchart-img').src = `/download/flowchart.png?t=${ts}`;
    }

    async function runTrace() {
      await fetch('/api/double-verify', { method: 'POST' });
      await fetchAllData();
      reloadVisuals();
      alert("Network graph and double verification re-traced.");
    }

    function zoomImage(imgId) {
      const img = document.getElementById(imgId);
      if (img.style.transform === 'scale(1.5)') {
        img.style.transform = 'scale(1)';
        img.style.cursor = 'zoom-in';
      } else {
        img.style.transform = 'scale(1.5)';
        img.style.cursor = 'zoom-out';
      }
    }
  </script>
</body>
</html>
