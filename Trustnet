def init_history_db() -> None:
    with sqlite3.connect(DB_PATH) as con:
        con.executescript("""
        CREATE TABLE IF NOT EXISTS archived_snapshots (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            archived_at TEXT NOT NULL,
            case_count INTEGER NOT NULL DEFAULT 0,
            record_count INTEGER NOT NULL DEFAULT 0,
            transaction_count INTEGER NOT NULL DEFAULT 0,
            entity_count INTEGER NOT NULL DEFAULT 0,
            note TEXT
        );
        CREATE TABLE IF NOT EXISTS archived_cases (
            snapshot_id INTEGER NOT NULL,
            case_id TEXT NOT NULL,
            filename TEXT,
            size_bytes INTEGER,
            uploaded_at TEXT,
            rows_extracted INTEGER,
            cleaned_rows INTEGER,
            extraction_json TEXT,
            PRIMARY KEY(snapshot_id, case_id),
            FOREIGN KEY(snapshot_id) REFERENCES archived_snapshots(id) ON DELETE CASCADE
        );
        CREATE TABLE IF NOT EXISTS archived_records (
            snapshot_id INTEGER NOT NULL,
            row_no INTEGER NOT NULL,
            transaction_id TEXT,
            sender TEXT,
            receiver TEXT,
            amount REAL,
            timestamp TEXT,
            case_id TEXT,
            record_json TEXT NOT NULL,
            PRIMARY KEY(snapshot_id, row_no),
            FOREIGN KEY(snapshot_id) REFERENCES archived_snapshots(id) ON DELETE CASCADE
        );
        CREATE INDEX IF NOT EXISTS idx_archived_txn ON archived_records(snapshot_id, transaction_id);
        CREATE TABLE IF NOT EXISTS archived_entities (
            snapshot_id INTEGER NOT NULL,
            account_id TEXT NOT NULL,
            profile_json TEXT NOT NULL,
            PRIMARY KEY(snapshot_id, account_id),
            FOREIGN KEY(snapshot_id) REFERENCES archived_snapshots(id) ON DELETE CASCADE
        );
        """)
        # Schema migrations for the case database. These columns make the archive
        # self-describing and give every saved case a stable report/QR token.
        existing = {row[1] for row in con.execute("PRAGMA table_info(archived_cases)").fetchall()}
        migrations = {
            "victim_name": "TEXT",
            "file_hash": "TEXT",
            "report_token": "TEXT",
            "report_url": "TEXT",
            "database_saved_at": "TEXT",
            "case_summary_json": "TEXT",
        }
        for col, typ in migrations.items():
            if col not in existing:
                con.execute(f"ALTER TABLE archived_cases ADD COLUMN {col} {typ}")
        con.execute("CREATE INDEX IF NOT EXISTS idx_archived_case_token ON archived_cases(report_token)")
        con.execute("CREATE INDEX IF NOT EXISTS idx_archived_case_victim ON archived_cases(victim_name)")


def history_count() -> int:
    try:
        with sqlite3.connect(DB_PATH) as con:
            row = con.execute("SELECT COUNT(*) FROM archived_snapshots").fetchone()
            return int(row[0] if row else 0)
    except Exception:
        return 0


def infer_victim_name(case_id: str, records: list[dict[str, Any]], entities: dict[str, dict[str, Any]]) -> str:
    """Resolve a victim name only from evidence already present in the uploaded dataset."""
    for profile in entities.values():
        if str(profile.get("role", "")).upper() == "VICTIM" and profile.get("name"):
            return str(profile.get("name"))
    for row in records:
        if str(row.get("case_id") or "") != str(case_id):
            continue
        if str(row.get("role", "")).upper() == "VICTIM" and row.get("name"):
            return str(row.get("name"))
    return "NOT AVAILABLE"


def archive_workspace_data(cases, records, cleaned, entities, note="Workspace archived by RESET WORKSPACE", include_bigdata: bool = False) -> int | None:
    if not cases and not records and not entities:
        return None
    now = datetime.now(timezone.utc).isoformat()
    with sqlite3.connect(DB_PATH) as con:
        con.execute("PRAGMA foreign_keys=ON")
        con.execute("PRAGMA synchronous=NORMAL")
        con.execute("PRAGMA journal_mode=WAL")
        estimated_transactions = sum(int(c.get("rows_extracted") or 0) for c in cases.values()) if any(c.get("extraction", {}).get("large_mode") for c in cases.values()) else len(cleaned)
        cur = con.execute(
            "INSERT INTO archived_snapshots(archived_at,case_count,record_count,transaction_count,entity_count,note) VALUES(?,?,?,?,?,?)",
            (now, len(cases), len(records), estimated_transactions, len(entities), note)
        )
        sid = int(cur.lastrowid)
        saved_at = datetime.now(timezone.utc).isoformat()
        case_rows = []
        for c in cases.values():
            token = c.get("report_token") or uuid.uuid4().hex
            c["report_token"] = token
            victim_name = c.get("victim_name") or infer_victim_name(c.get("case_id"), records, entities)
            c["victim_name"] = victim_name
            report_url = c.get("report_url") or f"/report/{token}"
            c["report_url"] = report_url
            summary = {
                "case_id": c.get("case_id"),
                "filename": c.get("filename"),
                "victim_name": victim_name,
                "rows_extracted": c.get("rows_extracted", 0),
                "cleaned_rows": c.get("cleaned_rows", 0),
                "uploaded_at": c.get("uploaded_at"),
                "file_hash": c.get("file_hash"),
                "extraction": c.get("extraction", {}),
            }
            case_rows.append((sid, c.get("case_id"), c.get("filename"), c.get("size_bytes"), c.get("uploaded_at"), c.get("rows_extracted"), c.get("cleaned_rows", 0), json.dumps(c.get("extraction", {}), default=str), victim_name, c.get("file_hash"), token, report_url, saved_at, json.dumps(summary, default=str)))
        if case_rows:
            con.executemany(
                "INSERT INTO archived_cases(snapshot_id,case_id,filename,size_bytes,uploaded_at,rows_extracted,cleaned_rows,extraction_json,victim_name,file_hash,report_token,report_url,database_saved_at,case_summary_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                case_rows
            )
        large_cases = {str(c.get("case_id")) for c in cases.values() if c.get("extraction", {}).get("large_mode")}
        if include_bigdata and large_cases and BIGDATA_DB_PATH.exists():
            row_no = 0
            with sqlite3.connect(BIGDATA_DB_PATH) as src:
                cur_src = src.execute("SELECT transaction_id,sender,receiver,amount,timestamp,case_id,record_json FROM transactions ORDER BY row_id")
                batch = []
                for transaction_id, sender, receiver, amount, timestamp, case_id, record_json in cur_src:
                    batch.append((sid, row_no, transaction_id, sender, receiver, amount, str(timestamp or ""), case_id, record_json))
                    row_no += 1
                    if len(batch) >= BIGDATA_SQL_BATCH:
                        con.executemany("INSERT INTO archived_records(snapshot_id,row_no,transaction_id,sender,receiver,amount,timestamp,case_id,record_json) VALUES(?,?,?,?,?,?,?,?,?)", batch)
                        batch.clear()
                if batch:
                    con.executemany("INSERT INTO archived_records(snapshot_id,row_no,transaction_id,sender,receiver,amount,timestamp,case_id,record_json) VALUES(?,?,?,?,?,?,?,?,?)", batch)
        else:
            record_rows = [(sid, i, r.get("transaction_id"), r.get("sender"), r.get("receiver"), parse_amount(r.get("amount")), str(r.get("timestamp") or ""), r.get("case_id"), json.dumps(r, default=str)) for i, r in enumerate(records)]
            if record_rows:
                con.executemany("INSERT INTO archived_records(snapshot_id,row_no,transaction_id,sender,receiver,amount,timestamp,case_id,record_json) VALUES(?,?,?,?,?,?,?,?,?)", record_rows)
        entity_rows = [(sid, str(k), json.dumps(profile, default=str)) for k, profile in entities.items()]
        if entity_rows:
            con.executemany("INSERT INTO archived_entities(snapshot_id,account_id,profile_json) VALUES(?,?,?)", entity_rows)
        con.commit()
    return sid

def archive_current_workspace() -> int | None:
    return archive_workspace_data(STATE.get("cases", {}), STATE.get("records", []), STATE.get("transactions", []), STATE.get("entity_profiles", {}), include_bigdata=bool(STATE.get("large_mode")))

def archive_snapshot_async(snapshot, note="Workspace archived asynchronously before RESET/REPLACE", include_bigdata: bool = False):
    def worker():
        try:
            with STATE_LOCK:
                STATE["database_status"] = "SAVING"
            sid = archive_workspace_data(*snapshot, note=note, include_bigdata=include_bigdata)
            with STATE_LOCK:
                STATE["archive_count"] = history_count()
                STATE["last_archive_snapshot_id"] = sid
                STATE["database_status"] = "SAVED"
        except Exception as exc:
            with STATE_LOCK:
                STATE["database_status"] = f"ERROR: {type(exc).__name__}"
    threading.Thread(target=worker, daemon=True).start()


def invalidate_caches() -> None:
    with CACHE_LOCK:
        PAYLOAD_CACHE.clear()


def set_process_progress(phase: str, percent: float, message: str = "", **extra) -> None:
    with PROCESS_LOCK:
        PROCESS_STATE.update({
            "phase": phase,
            "percent": max(0, min(100, round(float(percent), 1))),
            "message": message or phase.replace("_", " ").title(),
            **extra,
        })


def start_process_job(total_files: int) -> str:
    job_id = uuid.uuid4().hex
    with PROCESS_LOCK:
        PROCESS_STATE.update({
            "job_id": job_id, "phase": "processing", "percent": 0,
            "message": "Preparing dataset…", "filename": "", "rows": 0,
            "processed_files": 0, "total_files": total_files,
            "started_at": time.time(), "finished_at": None, "error": None, "active": True
        })
    return job_id


def finish_process_job(message: str = "Dataset processed successfully") -> None:
    with PROCESS_LOCK:
        PROCESS_STATE.update({"phase": "complete", "percent": 100, "message": message,
                              "finished_at": time.time(), "active": False})


def fail_process_job(message: str) -> None:
    with PROCESS_LOCK:
        PROCESS_STATE.update({"phase": "error", "message": message, "error": message,
                              "finished_at": time.time(), "active": False})


