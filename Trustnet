def norm_col(value: Any) -> str:
    s = re.sub(r"[^a-z0-9]+", "_", str(value or "").strip().lower()).strip("_")
    return s


def safe_filename(name: str) -> str:
    name = Path(name or "file").name
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", name)
    return name[:180] or "file"


def mask_value(field: str, value: Any) -> str:
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return "NOT AVAILABLE"
    s = str(value)
    if not s.strip():
        return "NOT AVAILABLE"
    if field == "phone":
        digits = re.sub(r"\D", "", s)
        return (digits[:5] + "XXXXX") if len(digits) >= 5 else "XXXXX"
    if field == "bank_account":
        return "X" * max(0, len(s) - 4) + s[-4:] if len(s) > 4 else "XXXX"
    if field == "upi_id":
        if "@" in s:
            user, dom = s.split("@", 1)
            return (user[:1] + "***@" + dom) if user else "***@" + dom
        return "***"
    if field == "address":
        parts = s.split()
        return " ".join(parts[:2]) + (" …" if len(parts) > 2 else "")
    if field == "ip":
        p = s.split(".")
        return ".".join(p[:2] + ["x", "x"]) if len(p) == 4 else "***"
    if field == "device_id":
        return s[:3] + "***" if len(s) > 3 else "***"
    return