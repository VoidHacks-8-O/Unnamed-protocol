                        "📊 Reading CSV..."
                    )

                    raw = pd.read_csv(
                        io.BytesIO(file_bytes),
                        low_memory=False
                    )

                    records = (
                        raw.to_dict(
                            orient="records"
                        )
                    )

                st.success(
                    f"📥 Extracted "
                    f"{len(records):,} candidate transactions."
                )

