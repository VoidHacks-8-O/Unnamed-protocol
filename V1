        # ----------------------------------------------------

        if (
            current_hash == cached_hash
            and database_ready()
        ):

            st.success(
                "⚡ This dataset is already processed."
            )

            st.info(
                "TRUSTNET is using the cached DuckDB database."
            )

        else:

            try:

                # ------------------------------------------------
                # PDF
                # ------------------------------------------------

                if uploaded_file.name.lower().endswith(
                    ".pdf"
                ):

